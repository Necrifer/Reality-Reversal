// Relative mob positions. Summoning also does not require an open position.
const ENTITY_OFFSETS = [
  [2, 1, 0], [-2, 1, 0], [0, 1, 2], [0, 1, -2],
  [2, 1, 2], [2, 1, -2], [-2, 1, 2], [-2, 1, -2],
  [3, 1, 0], [-3, 1, 0], [0, 1, 3], [0, 1, -3]
