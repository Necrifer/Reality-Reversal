// Runs a Minecraft command in the correct dimension with silent admin access.
function runAuraCommand(level, command) {
  const server = level.getServer()
  const source = server.createCommandSourceStack()
    .withLevel(level)
    .withPermission(4)
    .withSuppressedOutput()
  return server.getCommands().performPrefixedCommand(source, command)
}

// Converts an aura reading to 0 (normal), 1, 2, or 3 (most severe).
function tierNumberForAura(aura) {
  for (let index = LOW_AURA_TIERS.length - 1; index >= 0; index--) {
    if (aura <= LOW_AURA_TIERS[index].threshold) {
      return index + 1
    }
  }
  return 0
}
// This defines the area that allows the mob to spawn, and runs the command to summon.
function summonTierEntities(level, center, tier) {
  for (let index = 0; index < tier.entityCount; index++) {
    const offset = ENTITY_OFFSETS[index % ENTITY_OFFSETS.length]
    const ring = Math.floor(index / ENTITY_OFFSETS.length) * 2
    const x = javaCoordinate(center.getX()) + offset[0] + ring + 0.5
    const y = javaCoordinate(center.getY()) + offset[1]
    const z = javaCoordinate(center.getZ()) + offset[2] + ring + 0.5
    runAuraCommand(
      level,
      `summon ${tier.entityId} ${x} ${y} ${z} ${tier.entityNbt}`
    )
  }
}
// This runs the command on the area to apply the effects.
function applyTierEffects(level, center, tier) {
  for (const effect of tier.effects) {
    runAuraCommand(
      level,
      `effect give @a[x=${center.getX()},y=${center.getY()},` +
      `z=${center.getZ()},distance=..12] ${effect.id} ` +
      `${effect.durationSeconds} ${effect.amplifier} true`
    )
  }
}
// Resolves either a block registry id or a fluid registry id. This is more
// reliable than /setblock for mods whose fluid id differs from its block id.
function getPlacementState(placementId) {
  const BuiltInRegistries = Java.loadClass(
    'net.minecraft.core.registries.BuiltInRegistries'
  )
  const ResourceLocation = Java.loadClass(
    'net.minecraft.resources.ResourceLocation'
  )
  const parts = String(placementId).split(':')

  if (parts.length !== 2 || parts[0].length === 0 || parts[1].length === 0) {
    console.error(`[Aura Test Rig] Invalid placement id: ${placementId}.`)
    return null
  }

  const location = ResourceLocation.fromNamespaceAndPath(parts[0], parts[1])
  if (BuiltInRegistries.BLOCK.containsKey(location)) {
    return BuiltInRegistries.BLOCK.get(location).defaultBlockState()
  }
  if (BuiltInRegistries.FLUID.containsKey(location)) {
    return BuiltInRegistries.FLUID.get(location)
      .defaultFluidState()
      .createLegacyBlock()
  }

  console.error(
    `[Aura Test Rig] ${placementId} is neither a registered block nor fluid.`
  )
  return null
}

// Converts a wrapped Java coordinate to a native JavaScript integer. Direct
// Number(javaValue) conversion collapses these Minecraft integer wrappers in
// this Rhino environment, so conversion is performed through text instead.
function javaCoordinate(value) {
  const parsed = parseInt(String(value), 10)
  if (isNaN(parsed)) {
    throw new Error(`[Aura Test Rig] Invalid Java coordinate: ${value}`)
  }
  return parsed
}

// Converts a block position to a plain JavaScript key without Java equality.
function positionKey(pos) {
  return `${String(pos.getX())},${String(pos.getY())},${String(pos.getZ())}`
}

// Builds an offset position using only no-argument BlockPos methods. Rhino has
// collapsed both the overloaded BlockPos constructor and offset(x, y, z) to
// the center position in this instance, so numeric Java calls are avoided.
function positionFromOffset(center, offset) {
  let target = center
  let xSteps = Math.trunc(offset[0])
  let ySteps = Math.trunc(offset[1])
  let zSteps = Math.trunc(offset[2])

  while (xSteps > 0) {
    target = target.east()
    xSteps--
  }
  while (xSteps < 0) {
    target = target.west()
    xSteps++
  }
  while (ySteps > 0) {
    target = target.above()
    ySteps--
  }
  while (ySteps < 0) {
    target = target.below()
    ySteps++
  }
  while (zSteps > 0) {
    target = target.south()
    zSteps--
  }
  while (zSteps < 0) {
    target = target.north()
    zSteps++
  }

  return target
}

// Builds the protected world-position set directly from this controller's
// registered, rotated MMR pattern. This protects vanilla, third-party, and
// explicitly registered air positions without relying on block registry ids.
function getProtectedStructurePositionKeys(controller) {
  const BlockStateProperties = Java.loadClass(
    'net.minecraft.world.level.block.state.properties.BlockStateProperties'
  )
  const center = controller.getBlockPos()
  const centerX = javaCoordinate(center.getX())
  const centerY = javaCoordinate(center.getY())
  const centerZ = javaCoordinate(center.getZ())
  const protectedKeys = {}

  // Always protect the controller, including if MMR omits its MACHINE entry.
  protectedKeys[positionKey(center)] = true

  // Use the controller block state's facing exactly as MMR's own component
  // cache does. controller.getFacing() can represent a different orientation
  // convention and caused the protected pattern to be mapped to the wrong side.
  const structureFacing = controller.getBlockState()
    .getValue(BlockStateProperties.HORIZONTAL_FACING)
  const rotatedBlocks = controller.getFoundMachine()
    .getPattern()
    .getBlocks(structureFacing)
  const relativePositions = rotatedBlocks.keySet().toArray()

  for (const relativePos of relativePositions) {
    const worldKey =
      `${centerX + javaCoordinate(relativePos.getX())},` +
      `${centerY + javaCoordinate(relativePos.getY())},` +
      `${centerZ + javaCoordinate(relativePos.getZ())}`
    protectedKeys[worldKey] = true
  }

  return protectedKeys
}

function isProtectedStructurePosition(target, protectedKeys) {
  return protectedKeys[positionKey(target)] === true
}

// Safety fallback for MMR-owned controller/component blocks. Registered
// third-party blocks are protected by the positional pattern map above.
function isMMROwnedBlock(level, target) {
  const BuiltInRegistries = Java.loadClass(
    'net.minecraft.core.registries.BuiltInRegistries'
  )
  const blockId = String(
    BuiltInRegistries.BLOCK.getKey(level.getBlockState(target).getBlock())
  )
  return blockId.startsWith('modular_machinery_reborn:')
}

// Replaces multiple distinct positions directly through ServerLevel. It does
// not require air, but it skips protected structure positions unless the tier
// explicitly sets replaceStructure: true.
function placeTierReplacements(controller, tier) {
  const level = controller.getLevel()
  const center = controller.getBlockPos()
  const replacementState = getPlacementState(tier.placementId)
  if (replacementState === null) {
    return 0
  }

  const offsets = tier.replaceStructure
    ? [[0, 0, 0]].concat(REPLACEMENT_OFFSETS)
    : REPLACEMENT_OFFSETS
  const requested = Math.max(0, Math.floor(Number(tier.placementCount)))
  let replaced = 0
  let protectedSkips = 0
  let duplicateSkips = 0
  const attemptedKeys = {}
  const duplicateExamples = []
  const failedTargets = []
  const BuiltInRegistries = Java.loadClass(
    'net.minecraft.core.registries.BuiltInRegistries'
  )
  const replacementBlockId = String(
    BuiltInRegistries.BLOCK.getKey(replacementState.getBlock())
  )
  const protectedKeys = tier.replaceStructure
    ? null
    : getProtectedStructurePositionKeys(controller)

  for (let index = 0; index < offsets.length && replaced < requested; index++) {
    const offset = offsets[index]
    const target = positionFromOffset(center, offset)
    const targetKey = positionKey(target)

    // Never count the same physical position more than once. This also leaves
    // an explicit diagnostic if Java interop ever collapses coordinates again.
    if (attemptedKeys[targetKey] === true) {
      duplicateSkips++
      if (duplicateExamples.length < 3) {
        duplicateExamples.push(
          `[${offset.join(',')}]=>${target.toShortString()} key=${targetKey}`
        )
      }
      continue
    }
    attemptedKeys[targetKey] = true

    if (!tier.replaceStructure &&
        (isProtectedStructurePosition(target, protectedKeys) ||
         isMMROwnedBlock(level, target))) {
      protectedSkips++
      continue
    }

    // Do not trust only setBlockAndUpdate's boolean: some modded blocks report
    // false even when their resulting block state is present. Verify the world.
    level.setBlockAndUpdate(target, replacementState)
    const placedBlockId = String(
      BuiltInRegistries.BLOCK.getKey(level.getBlockState(target).getBlock())
    )
    if (placedBlockId === replacementBlockId) {
      replaced++
    } else if (failedTargets.length < 5) {
      failedTargets.push(target.toShortString())
    }
  }

  if (replaced < requested) {
    console.warn(
      `[Aura Test Rig] Requested ${requested} replacements but completed ` +
      `${replaced}; protected skips=${protectedSkips}; duplicate skips=` +
      `${duplicateSkips}; duplicate examples=` +
      `${duplicateExamples.length > 0 ? duplicateExamples.join('; ') : 'none'}; ` +
      `failed targets=` +
      `${failedTargets.length > 0 ? failedTargets.join('; ') : 'none'}.`
    )
  }
  return replaced
}

function fireTierBackfire(controller, tier, tierNumber, aura) {
  const level = controller.getLevel()
  const center = controller.getBlockPos()
  summonTierEntities(level, center, tier)
  applyTierEffects(level, center, tier)
  const replacementsMade = placeTierReplacements(controller, tier)
  console.info(
    `[Aura Test Rig] LOW tier ${tierNumber} (${tier.name}) fired at ` +
    `${center.toShortString()}; aura=${aura}; entities=${tier.entityCount}; ` +
    `replacements=${replacementsMade}/${tier.placementCount} x ` +
    `${tier.placementId}.`
  )
}

function reactImmediatelyToAura(controller, aura) {
  const stateData = controller.getPersistentData()
  let oldTierNumber = stateData.getInt(REACTION_STATE_KEY)

  if (oldTierNumber < 0 || oldTierNumber > LOW_AURA_TIERS.length) {
    oldTierNumber = 0
  }

  const detectedTierNumber = tierNumberForAura(aura)
  let newTierNumber = oldTierNumber

  if (detectedTierNumber > oldTierNumber) {
    newTierNumber = detectedTierNumber

    // Save first: a destructive tier may replace the controller below.
    stateData.putInt(REACTION_STATE_KEY, newTierNumber)
    controller.setChanged()

    // Recipe functions run while MMR is iterating its requirement list.
    // Changing blocks here can make MMR rebuild that list mid-iteration and
    // throw ConcurrentModificationException. Run the backfire one tick later,
    // after MMR has completely exited recipe processing.
    controller.getLevel().getServer().scheduleInTicks(1, scheduledEvent => {
      fireTierBackfire(
        controller,
        LOW_AURA_TIERS[newTierNumber - 1],
        newTierNumber,
        aura
      )
    })
    return
  }

  // Recovery never causes a backfire. It only rearms lower tiers so a later
  // aura decline can trigger them again without rapid threshold oscillation.
  if (detectedTierNumber < oldTierNumber) {
    const oldTier = LOW_AURA_TIERS[oldTierNumber - 1]
    if (aura >= oldTier.resetAt) {
      newTierNumber = detectedTierNumber
    }
  }

  if (newTierNumber !== oldTierNumber) {
    stateData.putInt(REACTION_STATE_KEY, newTierNumber)
    controller.setChanged()
  }
}

MMREvents.recipeFunction(AURA_FUNCTION, event => {
  const action = String(event.get(0))
  const amount = Number(event.get(1))

  if ((action !== 'drain' && action !== 'store') ||
      !Number.isFinite(amount) || amount <= 0) {
    console.error(
      `[Aura Test Rig] Invalid aura function arguments: action=${action}, ` +
      `amount=${event.get(1)}.`
    )
    return
  }

  const controller = event.getTile()
  const level = controller.getLevel()
  const center = controller.getBlockPos()
  const auraBefore = AuraChunk.getAuraInArea(
    level,
    center,
    AURA_MEASUREMENT_RADIUS
  )

  if (action === 'drain') {
    AuraChunk.drainAura(level, center, amount)
  } else {
    AuraChunk.storeAura(level, center, amount)
  }

  const auraAfter = AuraChunk.getAuraInArea(
    level,
    center,
    AURA_MEASUREMENT_RADIUS
  )

  console.info(
    `[Aura Test Rig] Recipe ${event.getRecipeId()} completed at ` +
    `${center.toShortString()}; ${action}=${amount}; ` +
    `aura before=${auraBefore}; after=${auraAfter}.`
  )

  reactImmediatelyToAura(controller, auraAfter)
})

})()
